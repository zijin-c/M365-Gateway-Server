# ==============================================================================
# M365 Gateway VPS 服务器配置模板
# 复制此文件为 .env：cp .env.example .env
# 或直接运行：node scripts/generate-keys.mjs --write-env
# ==============================================================================

# [网络监听配置]
# 监听地址：Docker 内部或直接部署在 VPS 上建议设为 0.0.0.0
HOST=0.0.0.0
# 服务监听端口
PORT=8787

# [数据持久化路径]
# 本地持久化目录（SQLite 数据库与加密凭据保存位置）
DATA_DIR=./data

# [运行环境]
ENVIRONMENT=production
TENANT_NAME=default
MAX_ACCOUNTS=40
DIRECT_NATIVE_TOOL_MODE=true

# [核心安全凭据 - 必填]
# 必须为 32 字节 Base64URL 编码（可通过 npm run generate-keys 生成）
DATA_ENCRYPTION_KEY=replace-with-a-32-byte-base64url-value
# 初次登录管理后台的管理员密码（至少 8 位，首次登录后可在后台修改）
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-random-password

# [可选安全配置]
# 可选：密码重置版本号（修改此值可强制重新激活 BOOTSTRAP_ADMIN_PASSWORD）
# ADMIN_PASSWORD_RESET_VERSION=

# 可选：Responses 压缩胶囊共享加密密钥
# COMPACTION_ENCRYPTION_KEY=

# 可选：部署时预创建的 API Key（若设置，Durable Object 启动时会将其哈希并存入数据库）
# BOOTSTRAP_GATEWAY_API_KEY=
# BOOTSTRAP_GATEWAY_API_KEY_NAME=default-admin

# [Microsoft 365 OAuth 配置]
# 默认使用官方公开公共客户端 ID；如需使用自定义 Entra ID 应用可在此覆盖
M365_CLIENT_ID=00000000-0000-0000-0000-000000000000
M365_AUTHORITY=https://login.microsoftonline.com/common
M365_REDIRECT_URI=https://login.microsoftonline.com/common/oauth2/nativeclient
M365_SCOPE=openid profile offline_access https://substrate.office.com/sydney/M365Chat.Read https://substrate.office.com/sydney/sydney.readwrite

