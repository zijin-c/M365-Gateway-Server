[Unit]
Description=M365 Gateway Server
Documentation=https://github.com/
After=network.target

[Service]
Type=simple
User=root
# 请根据实际安装路径修改 WorkingDirectory 和 ExecStart
WorkingDirectory=/opt/m365-gateway
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=5s
Environment=NODE_ENV=production
# 环境变量可从工作目录下的 .env 读取
EnvironmentFile=-/opt/m365-gateway/.env
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
